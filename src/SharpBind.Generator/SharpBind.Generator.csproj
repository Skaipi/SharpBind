<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <!-- Reflection over newer input libraries needs the newest installed runtime. -->
    <RollForward>LatestMajor</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharpBind.Tests" />
    <EmbeddedResource Include="Templates/*" WithCulture="false" LogicalName="SharpBind.Generator.Templates.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../python/common-runtime/native/abi.h" WithCulture="false"
                      LogicalName="SharpBind.Generator.Templates.Abi.h" />
  </ItemGroup>
</Project>
