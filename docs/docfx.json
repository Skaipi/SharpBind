{
  "build": {
    "content": [
      { "files": ["**/*.md", "**/toc.yml"], "exclude": ["_site/**"] }
    ],
    "resource": [
      { "files": ["images/**"] }
    ],
    "dest": "_site",
    "template": ["default", "modern", "templates/sharpbind"],
    "sitemap": { "baseUrl": "https://skaipi.github.io/SharpBind/" },
    "disableGitFeatures": true,
    "globalMetadata": {
      "_appName": "SharpBind",
      "_appTitle": "SharpBind documentation",
      "_appLogoPath": "images/SharpBind_small_logo.svg",
      "_appFaviconPath": "images/SharpBind_small_logo.svg",
      "_appFooter": "SharpBind · C# libraries for Python",
      "_enableSearch": true,
      "_disableContribution": true,
      "_lang": "en"
    }
  }
}
