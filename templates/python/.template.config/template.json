{
  "$schema": "http://json.schemastore.org/template",
  "author": "SharpBind",
  "classifications": ["Native", "Python", "Library"],
  "identity": "SharpBind.PythonPackage",
  "name": "SharpBind Python package with Native AOT bridge",
  "shortName": "sharpbind-python",
  "sourceName": "NativeBindings",
  "preferNameDirectory": true,
  "symbols": {
    "library": {
      "type": "parameter",
      "datatype": "string",
      "description": "Managed .csproj path relative to the generated native/ directory.",
      "isRequired": true,
      "replaces": "MANAGED_PROJECT_PATH"
    },
    "module": {
      "type": "parameter",
      "datatype": "string",
      "description": "Top-level ASCII Python import name, for example example_lib.",
      "isRequired": true,
      "replaces": "PYTHON_MODULE",
      "fileRename": "PYTHON_MODULE"
    },
    "distribution": {
      "type": "derived",
      "valueSource": "module",
      "valueTransform": "distributionName",
      "replaces": "PYTHON_DISTRIBUTION"
    }
  },
  "forms": {
    "distributionName": { "identifier": "replace", "pattern": "_", "replacement": "-" }
  }
}
